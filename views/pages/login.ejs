<div id="app" class="page-wrap py-8 md:py-16 flex flex-col md:flex-row md:items-center gap-10 md:gap-24">
  <img src="https://images.unsplash.com/photo-1508610048659-a06b669e3321?w=900" alt="" class="hidden md:block w-[520px] h-[632px] object-cover rounded-t-full flex-shrink-0">
  <div class="flex-1 md:pr-24 max-w-xl">
    <h1 class="font-display text-4xl md:text-[56px] mb-6 md:mb-8">{{ activeTab === 'login' ? '歡迎回來' : '加入花漾生活' }}</h1>
    <div class="flex gap-7 border-b border-line mb-6 md:mb-8" role="tablist">
      <button role="tab" @click="activeTab = 'login'; errors = {}" class="pb-3 text-[17px] md:text-lg border-b-[3px] -mb-px transition-colors" :class="activeTab === 'login' ? 'border-iris font-bold' : 'border-transparent text-mute'">登入</button>
      <button role="tab" @click="activeTab = 'register'; errors = {}" class="pb-3 text-[17px] md:text-lg border-b-[3px] -mb-px transition-colors" :class="activeTab === 'register' ? 'border-iris font-bold' : 'border-transparent text-mute'">註冊</button>
    </div>

    <form v-if="activeTab === 'login'" @submit.prevent="handleLogin" class="space-y-6 md:space-y-8">
        <div>
          <label class="block text-sm text-mute mb-1">Email</label>
          <input v-model="loginForm.email" type="email" placeholder="請輸入 Email" class="field" :class="{ 'has-error': errors.email }" />
          <p v-if="errors.email" class="text-danger text-[13px] mt-1.5">{{ errors.email }}</p>
        </div>
        <div>
          <label class="block text-sm text-mute mb-1">密碼</label>
          <input v-model="loginForm.password" type="password" placeholder="請輸入密碼" class="field" :class="{ 'has-error': errors.password }" />
          <p v-if="errors.password" class="text-danger text-[13px] mt-1.5">{{ errors.password }}</p>
        </div>
      <button type="submit" :disabled="submitting" class="btn-primary w-full text-base">{{ submitting ? '登入中...' : '登入' }}</button>
      <p class="text-[13px] md:text-sm text-mute">還沒有帳號？切換到「註冊」，只需姓名、Email 與 6 個字元以上的密碼。</p>
    </form>

    <form v-else @submit.prevent="handleRegister" class="space-y-6 md:space-y-8">
        <div>
          <label class="block text-sm text-mute mb-1">姓名</label>
          <input v-model="registerForm.name" type="text" placeholder="請輸入姓名" class="field" :class="{ 'has-error': errors.name }" />
          <p v-if="errors.name" class="text-danger text-[13px] mt-1.5">{{ errors.name }}</p>
        </div>
        <div>
          <label class="block text-sm text-mute mb-1">Email</label>
          <input v-model="registerForm.email" type="email" placeholder="請輸入 Email" class="field" :class="{ 'has-error': errors.email }" />
          <p v-if="errors.email" class="text-danger text-[13px] mt-1.5">{{ errors.email }}</p>
        </div>
        <div>
          <label class="block text-sm text-mute mb-1">密碼</label>
          <input v-model="registerForm.password" type="password" placeholder="至少 6 個字元" class="field" :class="{ 'has-error': errors.password }" />
          <p v-if="errors.password" class="text-danger text-[13px] mt-1.5">{{ errors.password }}</p>
        </div>
      <button type="submit" :disabled="submitting" class="btn-primary w-full text-base">{{ submitting ? '註冊中...' : '註冊' }}</button>
    </form>
  </div>
</div>

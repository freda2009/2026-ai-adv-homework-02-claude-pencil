<div id="app" class="page-wrap pt-7 md:pt-14 pb-12 md:pb-24">
  <h1 class="font-display text-4xl md:text-[56px] mb-6 md:mb-10">購物車</h1>

  <div v-if="loading" class="flex justify-center py-12"><div class="w-8 h-8 border-4 border-iris border-t-transparent rounded-full animate-spin"></div></div>

  <div v-else-if="items.length === 0" class="py-8">
    <p class="font-display text-2xl mb-2">購物車是空的</p>
    <p class="text-mute text-sm mb-6">挑一束喜歡的花，放進來吧。</p>
    <a href="/" class="btn-primary inline-block">去逛逛</a>
  </div>

  <template v-else>
    <div class="mb-8 md:mb-10">
      <p v-if="total < 500" class="text-[15px] text-iris font-medium mb-2.5">再買 NT$ {{ (500 - total).toLocaleString() }} 即可免運。</p>
      <p v-else class="text-[15px] text-ok font-medium mb-2.5">已達免運門檻，這張訂單不收運費。</p>
      <div class="h-1.5 rounded-full bg-line overflow-hidden">
        <div class="h-full rounded-full" :class="total >= 500 ? 'bg-ok' : 'bg-iris'" :style="{ width: Math.min(100, total / 5) + '%' }"></div>
      </div>
    </div>

    <div class="flex flex-col lg:flex-row gap-8 lg:gap-16">
      <ul class="flex-1">
        <li v-for="item in items" :key="item.id" class="flex items-center gap-3.5 md:gap-6 py-4 md:py-6 border-b border-line">
          <img
            :src="item.product.image_url || 'https://images.unsplash.com/photo-1490750967868-88aa4f44baee?w=100'"
            :alt="item.product.name"
            class="w-20 h-24 md:w-[104px] md:h-[104px] object-cover rounded-t-full flex-shrink-0"
          />
          <div class="flex-1 min-w-0 flex flex-col md:flex-row md:items-center gap-2 md:gap-6">
            <div class="flex-1 min-w-0">
              <h3 class="font-display text-[17px] md:text-[22px] truncate">{{ item.product.name }}</h3>
              <p class="text-[13px] md:text-sm text-mute">NT$ {{ item.product.price.toLocaleString() }}</p>
            </div>
            <div class="flex items-center justify-between md:gap-6">
              <div class="flex items-center border border-ink rounded overflow-hidden">
                <button @click="updateQuantity(item.id, item.quantity - 1)" :disabled="item.quantity <= 1" aria-label="減少數量" class="w-9 h-9 md:w-11 md:h-11 hover:bg-ink hover:text-paper disabled:opacity-40">−</button>
                <span class="w-9 h-9 md:w-11 md:h-11 flex items-center justify-center">{{ item.quantity }}</span>
                <button @click="updateQuantity(item.id, item.quantity + 1)" :disabled="item.quantity >= item.product.stock" aria-label="增加數量" class="w-9 h-9 md:w-11 md:h-11 hover:bg-ink hover:text-paper disabled:opacity-40 disabled:cursor-not-allowed">+</button>
              </div>
              <p class="font-bold text-[15px] md:text-[17px] md:w-28 text-right">NT$ {{ (item.product.price * item.quantity).toLocaleString() }}</p>
            </div>
          </div>
          <button @click="confirmDelete(item.id)" aria-label="移除商品" class="text-mute hover:text-danger transition-colors text-sm px-1">移除</button>
        </li>
      </ul>

      <aside class="lg:w-[420px] bg-ink text-paper rounded p-6 md:p-8 flex flex-col gap-4 self-start w-full">
        <h2 class="font-display text-[26px] text-pollen">訂單金額</h2>
        <div class="flex justify-between text-[#C9D4CD]"><span>商品小計</span><span class="text-paper">NT$ {{ total.toLocaleString() }}</span></div>
        <div class="flex justify-between text-[#C9D4CD]"><span>運費</span><span class="text-paper">{{ total >= 500 ? '免運' : 'NT$ 150' }}</span></div>
        <div class="flex justify-between items-center border-t border-[#3C5A50] pt-4">
          <span>總計</span>
          <span class="font-display text-[28px] md:text-[32px] text-pollen">NT$ {{ (total + (total >= 500 ? 0 : 150)).toLocaleString() }}</span>
        </div>
        <button @click="goCheckout" class="bg-pollen text-ink font-medium py-3.5 rounded hover:brightness-95 transition">前往結帳</button>
      </aside>
    </div>
  </template>

  <div v-if="confirmVisible" class="fixed inset-0 z-50 flex items-center justify-center" role="dialog" aria-modal="true">
    <div class="absolute inset-0 bg-ink/60" @click="confirmVisible = false"></div>
    <div class="relative bg-surface rounded shadow-xl w-full max-w-sm mx-4 p-6">
      <h3 class="font-display text-xl mb-2">移除這項商品？</h3>
      <p class="text-mute text-sm mb-6">移除後會從購物車消失，你可以再從商品頁加入。</p>
      <div class="flex gap-3 justify-end">
        <button @click="confirmVisible = false" class="btn-outline !py-2 !px-4 text-sm">取消</button>
        <button @click="handleDelete" class="px-4 py-2 text-sm rounded bg-danger text-white hover:brightness-110">移除</button>
      </div>
    </div>
  </div>
</div>

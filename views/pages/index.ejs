<div id="app">
  <!-- Hero -->
  <section class="page-wrap pt-8 md:pt-16 flex flex-col md:flex-row md:items-stretch gap-8 md:gap-12">
    <div class="flex-1 flex flex-col justify-center gap-5 md:gap-7">
      <h1 class="font-display text-[52px] md:text-[104px] leading-[1.15]">今天，<br>把花帶回家</h1>
      <p class="text-[15px] md:text-lg leading-[1.7] text-mute max-w-[480px]">每一束都由花藝師當天手工包紮。台北市區下單，當日送達。</p>
      <div class="flex items-center gap-6">
        <a href="#products" class="btn-primary flex-1 md:flex-none md:px-8 text-base">選購本週花束</a>
        <a href="#products" class="hidden md:inline underline underline-offset-4 text-base">看花況表</a>
      </div>
    </div>
    <div class="relative md:w-[560px] pb-0">
      <img src="https://images.unsplash.com/photo-1487530811176-3780de880c2d?w=900" alt="花束" class="w-full max-w-[520px] h-[420px] md:h-[656px] object-cover rounded-t-full">
      <aside class="absolute right-0 bottom-8 md:bottom-24 w-[220px] md:w-[260px] bg-ink text-paper rounded p-3.5 md:p-5" aria-label="本週花況">
        <div class="flex items-center justify-between mb-2 md:mb-3">
          <span class="font-display text-base md:text-xl text-pollen">本週花況</span>
          <span class="text-[11px] md:text-xs text-[#B9C6BE]">每週更新</span>
        </div>
        <div v-for="p in products.slice(0, 4)" :key="p.id" class="flex justify-between border-t border-[#3C5A50] pt-1.5 mt-1.5 md:pt-2 md:mt-2 text-xs md:text-[13px]">
          <span class="truncate pr-2">{{ p.name }}</span>
          <span class="font-bold text-pollen">{{ p.price.toLocaleString() }}</span>
        </div>
      </aside>
    </div>
  </section>

  <!-- Products -->
  <section id="products" class="bg-surface mt-12 md:mt-16 py-12 md:py-24">
    <div class="page-wrap">
      <div class="flex items-end justify-between mb-8 md:mb-12">
        <h2 class="font-display text-[32px] md:text-5xl">所有花藝</h2>
        <p class="hidden md:block text-[15px] text-mute">每週依產地調整供應</p>
      </div>

      <div v-if="loading" class="flex justify-center py-12"><div class="w-8 h-8 border-4 border-iris border-t-transparent rounded-full animate-spin"></div></div>

      <template v-else>
        <div v-if="products.length === 0" class="py-12">
          <p class="font-display text-2xl">目前沒有商品</p>
          <p class="text-mute text-sm mt-2">新花還在路上，請稍後再來看看。</p>
        </div>

        <div v-else class="grid grid-cols-2 lg:grid-cols-4 gap-x-3.5 md:gap-x-8 gap-y-8 md:gap-y-12">
          <article v-for="(product, idx) in products" :key="product.id" class="flex flex-col gap-2 md:gap-3.5 group">
            <a :href="'/products/' + product.id" class="block overflow-hidden" @click.prevent="goToProduct(product.id)">
              <img
                :src="product.image_url || 'https://images.unsplash.com/photo-1490750967868-88aa4f44baee?w=400'"
                :alt="product.name"
                class="w-full object-cover aspect-[4/5] group-hover:scale-[1.03] transition-transform duration-300"
                :class="idx % 2 === 0 ? 'rounded-t-[999px]' : ''"
              />
            </a>
            <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-1.5">
              <h3 class="font-display text-base md:text-xl">{{ product.name }}</h3>
              <span class="self-start bg-pollen text-ink text-xs md:text-sm font-bold px-2 md:px-2.5 py-0.5 md:py-1 rounded-sm">NT$ {{ product.price.toLocaleString() }}</span>
            </div>
            <button
              @click.stop="addToCart(product)"
              :disabled="product._adding || product.stock <= 0"
              class="btn-outline !py-2.5 text-sm disabled:opacity-50 disabled:cursor-not-allowed"
            >
              {{ product.stock <= 0 ? '已售完' : '加入購物車' }}
            </button>
          </article>
        </div>

        <div v-if="pagination.totalPages > 1" class="flex justify-center gap-2 mt-12">
          <button
            v-for="p in pagination.totalPages"
            :key="p"
            @click="loadProducts(p)"
            class="w-10 h-10 rounded text-sm transition-colors border border-ink"
            :class="p === pagination.page ? 'bg-ink text-paper' : 'hover:bg-ink hover:text-paper'"
          >
            {{ p }}
          </button>
        </div>
      </template>
    </div>
  </section>

  <!-- Story -->
  <section class="bg-ink text-paper flex flex-col md:flex-row">
    <img src="https://images.unsplash.com/photo-1508610048659-a06b669e3321?w=900" alt="花藝師" class="w-full md:w-[620px] h-[220px] md:h-[520px] object-cover">
    <div class="flex-1 flex flex-col justify-center gap-4 md:gap-6 p-7 md:px-24 md:py-12">
      <h2 class="font-display text-[30px] md:text-[56px]">專心做好一束花</h2>
      <p class="text-[15px] md:text-[17px] leading-[1.8] text-[#C9D4CD] max-w-[560px]">花漾生活 2020 年成立於台北。不囤花，每天依訂單向產地叫貨，隔天就到你手上；包裝只用牛皮紙與麻繩，花謝之後不留垃圾。</p>
      <dl class="flex flex-wrap gap-x-12 gap-y-4 mt-2">
        <div><dt class="font-display text-[22px] text-pollen">當日配送</dt><dd class="text-sm text-[#C9D4CD]">台北市區</dd></div>
        <div><dt class="font-display text-[22px] text-pollen">免運門檻</dt><dd class="text-sm text-[#C9D4CD]">NT$ 500</dd></div>
        <div><dt class="font-display text-[22px] text-pollen">保鮮小卡</dt><dd class="text-sm text-[#C9D4CD]">每束附贈</dd></div>
      </dl>
    </div>
  </section>
</div>

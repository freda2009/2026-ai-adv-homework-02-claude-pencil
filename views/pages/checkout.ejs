<div id="app" class="page-wrap pt-7 md:pt-14 pb-12 md:pb-24">
  <h1 class="font-display text-4xl md:text-[56px] mb-6 md:mb-10">結帳</h1>
  <div v-if="loading" class="flex justify-center py-12"><div class="w-8 h-8 border-4 border-iris border-t-transparent rounded-full animate-spin"></div></div>
  <div v-else class="flex flex-col lg:flex-row gap-10 lg:gap-24">
    <div class="flex-1">
      <h2 class="font-display text-[22px] md:text-[28px] mb-6 md:mb-8">收件資訊</h2>
      <div class="space-y-6 md:space-y-8">
        <div>
          <label class="block text-sm text-mute mb-1">收件人姓名</label>
          <input v-model="form.recipientName" type="text" placeholder="請輸入收件人姓名" class="field" :class="{ 'has-error': errors.recipientName }" />
          <p v-if="errors.recipientName" class="text-danger text-[13px] mt-1.5">{{ errors.recipientName }}</p>
        </div>
        <div>
          <label class="block text-sm text-mute mb-1">Email</label>
          <input v-model="form.recipientEmail" type="email" placeholder="請輸入 Email" class="field" :class="{ 'has-error': errors.recipientEmail }" />
          <p v-if="errors.recipientEmail" class="text-danger text-[13px] mt-1.5">{{ errors.recipientEmail }}</p>
        </div>
        <div>
          <label class="block text-sm text-mute mb-1">收件地址</label>
          <input v-model="form.recipientAddress" type="text" placeholder="請輸入收件地址" class="field" :class="{ 'has-error': errors.recipientAddress }" />
          <p v-if="errors.recipientAddress" class="text-danger text-[13px] mt-1.5">{{ errors.recipientAddress }}</p>
        </div>
      </div>
    </div>
    <aside class="lg:w-[480px] bg-surface border border-line rounded p-5 md:p-8 flex flex-col gap-4 self-start w-full">
      <h2 class="font-display text-xl md:text-[26px]">訂單摘要</h2>
      <div v-for="item in cartItems" :key="item.id" class="flex justify-between text-[15px]">
        <span class="text-mute">{{ item.product.name }} × {{ item.quantity }}</span>
        <span>NT$ {{ (item.product.price * item.quantity).toLocaleString() }}</span>
      </div>
      <div class="flex justify-between text-[15px]">
        <span class="text-mute">運費</span><span>{{ cartTotal >= 500 ? '免運' : 'NT$ 150' }}</span>
      </div>
      <div class="flex justify-between items-center border-t border-line pt-4">
        <span class="font-bold">總計</span>
        <span class="font-display text-[26px] md:text-[32px]">NT$ {{ (cartTotal + (cartTotal >= 500 ? 0 : 150)).toLocaleString() }}</span>
      </div>
      <button @click="submitOrder" :disabled="submitting" class="btn-primary w-full text-base">
        {{ submitting ? '處理中...' : '確認送出訂單' }}
      </button>
    </aside>
  </div>
</div>
